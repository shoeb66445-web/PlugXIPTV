 <application android:name=".PlugXApp" android:label="PlugX IPTV" android:icon="@drawable/plugx_logo" android:banner="@drawable/plugx_logo" android:theme="@style/AppTheme" android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/network_security_config" android:allowBackup="false" android:supportsRtl="true">
